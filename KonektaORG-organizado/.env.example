KONEKTA_PIN=SUBSTITUA_POR_UM_SEGREDO_LONGO_E_ALEATORIO
KONEKTA_TEL_SUPORTE=+258 84 000 0000
KONEKTA_TEL_EMERGENCIA=+258 84 000 0001
KONEKTA_TEL_PAGAMENTOS=+258 84 000 0002
